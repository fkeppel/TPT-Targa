                @foreach ($data['tAssortment']['Online']['values'] as $delno =>  $delivery)
                <h3>Variantenbestellmengen Onlineshops: frühester Liefertermin</h3>
                <table>
                    <tr>
                        <th>GTIN</th>
                        <th>GTIN KL</th>
                        <th>Stylenummer</th>
                        <th>Style Bezeichnung</th>
                        <th>Größe</th>
                        <th>LSV Code</th>
                        <th>LSV</th>
                        @foreach ($data['tAssortment']['Online']['countries'][$delno] as $country => $val)
                        <th>{{ $country }}</th>
                        @endforeach
                        <th>Summe OS</th>
                    </tr>
                    @foreach ($delivery as $gtin => $gtins)
                        <?php $summe = 0; ?>
                        <tr>
                            <td>{{ $gtin }}</td>
                            @foreach ($gtins as $gtinKL => $KLs)
                                <td>{{ $gtinKL }}</td>
                                @foreach ($KLs as $styleNo => $styles1)
                                    <td>{{ $styleNo }}</td>
                                    @foreach ($styles1 as $stylebez => $styles)
                                        <td>{{ $stylebez }}</td>
                                        @foreach ($styles as $size => $sizes)
                                            <td>{{ $size }}</td>
                                            @foreach ($sizes as $lsv => $countries)
                                                <td>{{ $data['tLsv']['codes'][$lsv]['code']??'N.N.' }}</td>
                                                <td>{{ $lsv }}</td>
                                                @foreach ($countries as $country => $menge)
                                                <td style="text-align:right;padding-right:4px;">{{ number_format($menge,0,',','.') }}</td>
                                                <?php $summe += $menge ?>
                                                @endforeach
                                                <td style="text-align:right;padding-right:4px;">{{ number_format($summe,0,',','.') }}</td>
                                            @endforeach
                                        @endforeach
                                    @endforeach
                                @endforeach
                            @endforeach
                        </tr>
                    @endforeach
