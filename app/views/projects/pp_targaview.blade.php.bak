                    @if ( true or  strpos($country, 'CB8') === false )
                        <?php 
                            $ca = explode(',', $country);
                            $resC = '';
                            $_land = 'X';
                            $lines=0;
                            foreach($ca as $c){
                                if ($c == 'CB5-OSES' or substr($c,0,3) == 'CB8' or substr($c,0,7) == 'CB10-KO'){
                                } else {
                                    if ($_land != substr($c,0,4)){
                                        $_land = substr($c,0,4);
                                        $resC .= PHP_EOL.str_replace('-','',substr($c,0,4)).': ';
                                        $comma = '';
                                        $lines++;
                                    }
                                    $headerLand = preg_replace('/CB.-/','', $c);
                                    $headerLand = preg_replace('/CB10./','', $headerLand);
                                    $resC = $resC .$comma. $headerLand;
                                    $comma = ',';
                                }
                            }
                            $lineHeight = 18;
                            $divHeight = $lineHeight * $lines;
                            $cbText = trim($resC);
                        ?>
                        <div  class="tgInput tgCompare cpcMarkerOK"><div style='border-radius:0px;line-height:{{$lineHeight}}px;height:{{$divHeight}}px!important;width:450px;background-color:transparent;padding:0px;overflow:auto;'>{{ $cbText }}</div></div>
